# Puerto interno del servidor (en Docker Compose se expone en 3090)
PORT=3090
TZ=America/Argentina/Cordoba

# Coordenadas de Córdoba Capital para Open-Meteo
WEATHER_LAT=-31.4187
WEATHER_LON=-64.1954
WEATHER_CITY=Córdoba Capital

# Personas y calendarios (Google Calendar y/o Outlook personal)
# Podés poner 1 o varios links ICS por persona separados por coma (,)
PERSON_1_NAME=Emi
PERSON_1_COLOR=#4f8cff
PERSON_1_ICS_URLS=

PERSON_2_NAME=Natali
PERSON_2_COLOR=#ff6fa8
PERSON_2_ICS_URLS=

# URL de Seguimiento Dietario (NutriPlan) en el HomeLab
NUTRIPLAN_URL=http://192.168.100.89:3080

# Cortes horarios para resaltar automáticamente la comida actual (formato HH:MM)
MEAL_LUNCH_FROM=11:00
MEAL_SNACK_FROM=16:00
MEAL_DINNER_FROM=19:30

# Modo noche automático (atenúa brillo y contraste en la tablet)
NIGHT_START=23:00
NIGHT_END=06:00
